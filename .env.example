# Vorlage. Diese Datei enthaelt keine echten Zugangsdaten und darf das nie.
#
# Es gibt zwei Sorten von Werten:
#
#   NEXT_PUBLIC_*  werden beim Build ins HTML eingebacken und sind damit
#                  oeffentlich sichtbar. Im Cloudflare-Projekt unter
#                  "Variables and Secrets" als *Variable* (nicht Secret) setzen,
#                  weil der Build sie braucht.
#
#   alles andere   liest der Worker zur Laufzeit (worker/index.js). Schluessel
#                  gehoeren dort als *Secret* hinterlegt, nie in eine Datei im
#                  Repo. Lokal zum Testen in .dev.vars (ist in .gitignore).

# --- Website ---

# Basis-URL fuer Meta-Tags, Sitemap, robots.txt und Link-Vorschauen.
# Ohne diese Variable greift die Domain aus app/data.ts.
NEXT_PUBLIC_SITE_URL=https://karlson-solo-orchester.de

# --- Anfrageformular ---

# Schaltet das Formular auf /buchung/ ein. Erst setzen, wenn der Versand
# unten steht und ein Zustellungstest geklappt hat. Ohne diese Variable
# zeigt die Seite nur Telefon und E-Mail — so wie vor dem Formular.
NEXT_PUBLIC_FORMULAR_AKTIV=1

# Oeffentlicher Turnstile-Sitekey (Spam-Schutz). Cloudflare-Dashboard ->
# Turnstile -> Add Site. Bleibt er leer, laesst das Formular Turnstile weg
# und laedt dann auch kein Cloudflare-Script; als Schutz bleibt nur der
# Honeypot. Fuer eine oeffentliche Seite ist das zu wenig — setzen.
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# --- Worker-Secrets (NICHT hier eintragen, siehe Kopf) ---
#
# MAILJET_API_KEY        Mailjet -> Account -> API Key Management, "API Key"
# MAILJET_SECRET_KEY     dieselbe Seite, "Secret Key"
# TURNSTILE_SECRET_KEY   zum Sitekey oben gehoerendes Secret
#
# MAIL_FROM   Absender der Anfrage-Mail. Muss eine bei Mailjet verifizierte
#             Adresse auf der eigenen Domain sein, z. B.
#             formular@karlson-solo-orchester.de. Kein Freemail-Absender und
#             kein Testabsender des Anbieters — das landet im Spam.
# MAIL_TO     Wohin die Anfrage geht, also Karlsons Postfach.
#
# MAIL_DRY_RUN=1        Nur zum Testen: baut die Mail und schreibt sie ins Log,
#                       sendet aber nicht. Im Produktivbetrieb weglassen.
# ERLAUBTE_HOSTS        Optional, Kommaliste. Zusaetzliche Hosts, von denen der
#                       Worker Formulare annimmt. Der eigene Host und localhost
#                       sind immer erlaubt, im Normalfall bleibt das leer.
