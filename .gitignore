# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / wrangler
.wrangler/
# Lokale Worker-Secrets fuer `wrangler dev`. Wird von `.env*` oben NICHT
# erfasst, deshalb hier eigens genannt — hier stehen echte Mailjet-Keys drin.
.dev.vars
.dev.vars.*

# typescript
*.tsbuildinfo
next-env.d.ts

# source material kept outside the deployable app
*.zip
*.pdf
karlson-website-briefing.md.txt
Photos-Galerie/
*.heic

# original image drops; curated deploy assets live in /public/karlson
*.jpg
!public/**/*.jpg

.vercel
